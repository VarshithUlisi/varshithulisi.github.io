---
import Base from '../../layouts/Base.astro';import Heading from '../../components/Heading.astro';import projects from '../../data/projects.json';import {path} from '../../lib/site';
---
<Base title="Projects"><Heading label="Ideas into initiatives" title="The work, in progress." description="Ventures, educational programs, and spaces for people to learn. Each account separates the work completed from the ambitions ahead."/>{projects.map((p,i)=><article class="list-row"><div><p class="eyebrow">0{i+1} / {p.area}</p><p class="meta">{p.role}</p></div><div><h2><a href={path(`projects/${p.slug}/`)}>{p.title}</a></h2><p>{p.summary}</p><a class="small-link" href={path(`projects/${p.slug}/`)}>Read the project account →</a></div></article>)}</Base>
