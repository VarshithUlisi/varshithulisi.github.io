---
import Base from '../../layouts/Base.astro';import Heading from '../../components/Heading.astro';import projects from '../../data/projects.json';import {path} from '../../lib/site';import {posts} from '../../lib/posts';
export function getStaticPaths(){return projects.map(project=>({params:{slug:project.slug},props:{project}}));}
const {project:p}=Astro.props;const related=(await posts()).filter(post=>post.data.related===p.slug);
---
<Base title={p.title} description={p.summary} schema={{"@type":"Organization",name:p.title,description:p.summary,...(p.url?{url:p.url}:{})}}><Heading label={p.area} title={p.title} description={p.summary}/><div class="reading-layout"><aside class="toc"><p>{p.role}</p><p class="meta">{p.period}</p><a href="#need">The need</a><a href="#initiative">The initiative</a><a href="#role">My contribution</a><a href="#results">Results & evidence</a><a href="#next">What comes next</a>{p.url&&<a href={p.url}>Project website ↗</a>}</aside><article class="prose"><h2 id="need">The need</h2><p>{p.need}</p><h2 id="initiative">The initiative</h2><p>{p.initiative}</p><h2 id="role">My contribution</h2><p>{p.contribution}</p><h2>The people</h2><p>{p.people}</p><h2 id="results">Results & evidence</h2><p>{p.results}</p><h2>What I learned</h2><p>{p.reflection}</p><h2 id="next">What comes next</h2><p>{p.next}</p><p class="note">Source: author-provided brag sheet, pp. {p.pages}. This is a self-reported account, adapted for the site. <a href={path('evidence/')}>Source and verification notes</a>.</p>{related.length>0&&<><h2>From the journal</h2>{related.map(post=><p><a href={path(`journal/${post.id}/`)}>{post.data.title}</a></p>)}</>}</article></div></Base>
