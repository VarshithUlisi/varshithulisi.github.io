---
import HallOfFameFeature from '../components/HallOfFameFeature.astro';
import Base from '../layouts/Base.astro';import Heading from '../components/Heading.astro';import {path} from '../lib/site';
const awards=[['Junior Achievement Social Innovation Challenge','Second place locally · National Qualifier','February 21, 2026 at Cincinnati Museum Center. The supplied Junior Achievement of OKI Partners plaque documents National Qualifier status and a top-5% finish.'],['Ohio FBLA State Leadership Conference','State Champion — Business Ethics · National Qualifier','February 25–26, 2026. The supplied Ohio FBLA plaque and medal document the state championship and national qualification.'],['Ohio FBLA State Leadership Conference','State Champion — Retail Management · National Qualifier','February 25–26, 2026. The supplied Ohio FBLA plaque and medal document the state championship and national qualification.'],['FBLA National Leadership Conference','Top 15 — Business Ethics','Source p. 12; competition year and official results to confirm.'],['Model United Nations','14 individual awards across 20+ conferences','Five Best Delegate, four Outstanding Delegate, three Honorable Mention, and two Best Position Paper awards. Source pp. 13–14; conference-by-conference records to confirm.'],["President’s Education Award",'Outstanding Academic Success · 2023','Source p. 12; certificate not supplied.'],['GE Advanced Manufacturing Day','Finalist','Source p. 12; event year and category to confirm.']];
---
<Base title="Recognition"><Heading label="Milestones along the way" title="Recognition, in context." description="Awards and public opportunities support the story of the work. Entries below are self-reported in my supplied material, with verification limits made explicit."/><HallOfFameFeature/><form class="filters" role="search"><label>Search recognition<input id="recognition-search" type="search" placeholder="Search award, organization, or field"/></label></form><p class="meta" id="award-count" aria-live="polite">{awards.length} award entries</p><section aria-label="Awards and competitions"><h2 class="sr-only">Awards and competitions</h2>{awards.map(([org,result,note])=><article class="list-row award" data-text={`${org} ${result}`.toLowerCase()}><h3>{org}</h3><div><p class="recognition-result">{result}</p><p class="source">{note}</p></div></article>)}<p id="no-awards" hidden>No award entries match that search.</p></section><section class="section"><h2>Speaking & presentations.</h2><p>Delivered the student testimonial at the 2026 Greater Butler & Warren Counties Business Hall of Fame on April 16, 2026. The event program and supplied recording document the appearance.</p><p>School-board and educational-leader presentations are described in the source. OSBA session details remain to be confirmed.</p><a href={path('journal/')}>Read the speaking and presentation records →</a></section><section class="section"><h2>Publications & research.</h2><article class="list-row"><h3>Sin Fronteras Literary Magazine</h3><div><p>Published short story: “Is This Reality: A Nightmarical Tale.”</p><p class="source">Self-reported, p. 11. Issue, date, and public publication link to confirm. Relative-age and publication-accolade claims are omitted.</p></div></article><article class="list-row"><h3>Research manuscript</h3><div><span class="tag">Approved · publication pending</span><p>The brag sheet describes approval through an IEEE-affiliated venue. It does not provide the title, venue, DOI, or formal publication record. This is not listed as a published paper.</p><p class="source">Source p. 11. Status is as reported in the supplied material, not a current independent confirmation.</p></div></article></section><section class="section"><h2>Items awaiting clarification.</h2><p>Junior Achievement competition rankings, cumulative service-hour claims, and organizational legal-status claims are withheld pending supporting records. Media features will be added only with an attributable publication link.</p><a href={path('evidence/')}>Review the evidence notes →</a></section></Base>
<script>
const search=document.querySelector<HTMLInputElement>('#recognition-search')!;const awards=[...document.querySelectorAll<HTMLElement>('.award')];search.addEventListener('input',()=>{let count=0;for(const award of awards){award.hidden=!award.dataset.text?.includes(search.value.trim().toLowerCase());if(!award.hidden)count++;}document.querySelector('#award-count')!.textContent=`${count} award entries`;document.querySelector<HTMLElement>('#no-awards')!.hidden=count!==0;});document.querySelector('form')!.addEventListener('submit',e=>e.preventDefault());
</script>
