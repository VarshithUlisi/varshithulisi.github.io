---
import Base from '../layouts/Base.astro';
import Heading from '../components/Heading.astro';
import projects from '../data/projects.json';
import {path,contact,linkedin} from '../lib/site';
---
<Base title="Media & professional resources" description="Biographies, a professional portrait, project summaries, and speaking inquiries for Varshith Sai Ulisi."><Heading label="For organizers, collaborators & reviewers" title="A useful introduction." description="A concise guide to my work, with resources for making an introduction or starting a conversation."/><section class="section resource-grid"><article><h2>Biographies</h2><p>Short and extended introductions for programs, profiles, and professional opportunities.</p><a href={path('biography.txt')} download>Download biographies ↓</a></article><article><h2>Portrait</h2><p>The portrait supplied for this website. Please identify the subject as Varshith Sai Ulisi.</p><a href={path('images/varshith-ulisi.png')} download>Download portrait ↓</a></article><article><h2>At a glance</h2><p>A printable one-page summary of selected work and education. Self-reported roles and outcomes remain subject to confirmation.</p><a href={path('resources/profile/')}>Open printable profile →</a></article></section><section class="section"><h2>Selected project summaries.</h2>{projects.slice(0,3).map(p=><article class="list-row"><h3>{p.title}</h3><div><p>{p.summary}</p><p class="meta">{p.role}</p><a href={path(`projects/${p.slug}/`)}>Project account & evidence →</a></div></article>)}</section><section class="section two-col"><div><h2>Topics I can discuss.</h2><p>Creating free STEM opportunities. Student entrepreneurship and mentorship. Learning through cross-cultural service. Building a product and responding to feedback.</p><p class="caption">Suggested conversation topics, not a list of talks already delivered.</p></div><div><h2>Let’s connect.</h2><p><a href={`mailto:${contact}`}>{contact}</a></p><p><a href={linkedin}>LinkedIn ↗</a></p><p>For an event, include the audience, format, date, and what you hope participants will take away.</p></div></section><p class="note">Please confirm current roles, award details, and event-specific information before using these materials. This public collection excludes school records, application essays, recommendation letters, and private financial information.</p></Base>
