---
import Base from '../layouts/Base.astro';
import Heading from '../components/Heading.astro';
import {posts} from '../lib/posts';
import {path,dateLabel} from '../lib/site';
const entries=(await posts()).filter(p=>p.data.eventDate||['Events','Speaking','Presentations'].includes(p.data.category)).sort((a,b)=>(b.data.eventDate||b.data.published).valueOf()-(a.data.eventDate||a.data.published).valueOf());
---
<Base title="Events & speaking"><Heading label="On stage, in the room, behind the scenes" title="Events & speaking." description="Presentations, conferences, competitions, and community experiences. Each record describes my role and separates the event date from the date I wrote about it."/><div class="links blog-actions"><a class="button" href={path('contact/#speaking')}>Invite me to speak ↗</a><a href={path('studio/?type=event')}>Add an event →</a><a href={path('journal/')}>Read the blog →</a></div><section class="section"><p class="eyebrow">From the archive</p>{entries.map(p=><article class="event-row"><div class="event-date">{p.data.eventDate?<time datetime={p.data.eventDate.toISOString()}>{dateLabel(p.data.eventDate)}</time>:<span>Event date<br/>to confirm</span>}</div><div>{p.data.image&&<img class="archive-photo" src={path(p.data.image)} alt={p.data.imageAlt} loading="lazy"/>}<p class="eyebrow">{p.data.category}</p><h2><a href={path(`journal/${p.id}/`)}>{p.data.title}</a></h2><p>{p.data.description}</p>{p.data.venue&&<p class="meta">{p.data.venue}</p>}<p class="meta">Article published {dateLabel(p.data.published)}</p></div></article>)}</section><section class="section"><h2>Earlier experiences.</h2><article class="event-row"><div class="event-date"><time datetime="2024-02-03">February 3, 2024</time></div><div><p class="eyebrow">Robotics · Guadalajara</p><h3>FIRST LEGO League</h3><p>I served as a referee, supporting fair scoring, consistent application of rules, and competition logistics.</p><p class="source">Author-supplied résumé, p. 11.</p></div></article><article class="event-row"><div class="event-date"><time datetime="2024-01">January 2024</time></div><div><p class="eyebrow">Diplomacy · Guadalajara</p><h3>GUAMUN</h3><p>Security Council cochair and conference operations support, helping facilitate debate and fair participation.</p><p class="source">Author-supplied résumé, pp. 10, 13–14. Exact conference dates and the human-resources title require confirmation.</p></div></article><p class="note">This is a growing record, not a complete event history. Photos, recordings, and exact dates will appear as they are supplied. The Junior Achievement entry documents selection to speak; speech delivery is not yet confirmed.</p></section></Base>
