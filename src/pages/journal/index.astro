---
import Base from '../../layouts/Base.astro';import Heading from '../../components/Heading.astro';import {posts} from '../../lib/posts';import {path,dateLabel} from '../../lib/site';
const all=await posts();const categories=['Events','Speaking','Presentations','Community Service','Leadership','Ventures','Research','Personal Reflections'];
---
<Base title="Blog"><Heading label="Articles, field notes & personal reflections" title="The blog." description="A place for the projects, experiences, and questions I want to spend more time with. Technology, finance, leadership, and life between them."/><div class="links blog-actions"><a class="button" href={path('studio/')}>Write an article ↗</a><a href={path('events/')}>Browse events →</a><a href={path('rss.xml')}>Subscribe via RSS</a></div><p class="caption">These opening entries were adapted from my supplied account on November 11, 2026. Publication dates refer to these site entries; event timing is identified separately.</p><form class="filters" role="search"><label>Search the journal<input type="search" name="q" id="search" placeholder="Search stories or topics"/></label><label>Browse by category<select id="category" name="category"><option value="">All categories</option>{categories.map(c=><option value={c}>{c}</option>)}</select></label></form><p id="results" class="meta" role="status" aria-live="polite">{all.length} stories</p><div id="archive">{all.map(p=><article class="archive-item" data-search={`${p.data.title} ${p.data.description} ${p.data.category}`.toLowerCase()} data-category={p.data.category}>{p.data.image&&<a href={path(`journal/${p.id}/`)} tabindex="-1" aria-hidden="true"><img class="archive-photo" src={path(p.data.image)} alt="" loading="lazy"/></a>}<p class="eyebrow">{p.data.category}</p><h2><a href={path(`journal/${p.id}/`)}>{p.data.title}</a></h2><p>{p.data.description}</p><p class="meta">Published {dateLabel(p.data.published)}{p.data.eventDate?` · Event: ${dateLabel(p.data.eventDate)}`:p.data.eventLabel?` · ${p.data.eventLabel}`:''}</p></article>)}</div><p id="empty" hidden>No stories match that search. Try another phrase or choose all categories.</p></Base>
<script>
const input=document.querySelector<HTMLInputElement>('#search')!;const category=document.querySelector<HTMLSelectElement>('#category')!;const items=[...document.querySelectorAll<HTMLElement>('.archive-item')];const params=new URLSearchParams(location.search);input.value=params.get('q')||'';category.value=params.get('category')||'';
function filter(){let count=0;const q=input.value.trim().toLowerCase();for(const item of items){const show=(!q||item.dataset.search?.includes(q))&&(!category.value||category.value===item.dataset.category);item.hidden=!show;if(show)count++;}document.querySelector('#results')!.textContent=`${count} ${count===1?'story':'stories'}`;document.querySelector<HTMLElement>('#empty')!.hidden=count!==0;const url=new URL(location.href);q?url.searchParams.set('q',input.value):url.searchParams.delete('q');category.value?url.searchParams.set('category',category.value):url.searchParams.delete('category');history.replaceState(null,'',url);}
input.addEventListener('input',filter);category.addEventListener('change',filter);document.querySelector('form')!.addEventListener('submit',e=>{e.preventDefault();filter();});filter();
</script>
