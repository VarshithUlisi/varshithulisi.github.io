---
import Base from '../../layouts/Base.astro';import {posts} from '../../lib/posts';import {render} from 'astro:content';import {path,absolute,dateLabel,name} from '../../lib/site';import projects from '../../data/projects.json';
export async function getStaticPaths(){return (await posts()).map(post=>({params:{id:post.id},props:{post}}));}
const {post}=Astro.props;const {Content}=await render(post);const project=projects.find(p=>p.slug===post.data.related);
const schema={'@type':'BlogPosting',headline:post.data.title,description:post.data.description,datePublished:post.data.published.toISOString(),author:{'@type':'Person','@id':absolute('#person',Astro.site),name},mainEntityOfPage:absolute(`journal/${post.id}/`,Astro.site)};
---
<Base title={post.data.title} description={post.data.description} type="article" schema={schema}><header class="page-head article-head"><a class="article-back" href={path('journal/')}>← All stories</a><p class="eyebrow">Journal / {post.data.category}</p><h1>{post.data.title}</h1><p class="intro">{post.data.description}</p><p class="meta">By {name} · Published <time datetime={post.data.published.toISOString()}>{dateLabel(post.data.published)}</time>{(post.data.eventDate||post.data.eventLabel)&&<><br/>Event / period: {post.data.eventDate?<time datetime={post.data.eventDate.toISOString()}>{dateLabel(post.data.eventDate)}</time>:post.data.eventLabel}</>}</p>{post.data.venue&&<p class="meta">Venue: {post.data.venue}</p>}</header><div class="article-tools" aria-label="Reading tools"><span>Make this story yours</span><div><button type="button" id="reading-decrease" aria-label="Decrease article text size">A−</button><button type="button" id="reading-increase" aria-label="Increase article text size">A+</button><button type="button" id="reading-print">Print / save PDF</button></div></div><article class="prose article-body" id="story-body">{post.data.image&&<img src={path(post.data.image)} alt={post.data.imageAlt} loading="lazy"/>}<Content/>{project&&<p class="links"><a href={path(`projects/${project.slug}/`)}>Explore {project.title} →</a></p>}<p class="links"><a href={path('journal/')}>← Back to the journal</a></p></article></Base>

<script>const story=document.querySelector<HTMLElement>('#story-body');let scale=1;document.querySelector('#reading-decrease')?.addEventListener('click',()=>{scale=Math.max(.9,+(scale-.1).toFixed(1));story?.style.setProperty('--reading-scale',String(scale));});document.querySelector('#reading-increase')?.addEventListener('click',()=>{scale=Math.min(1.3,+(scale+.1).toFixed(1));story?.style.setProperty('--reading-scale',String(scale));});document.querySelector('#reading-print')?.addEventListener('click',()=>window.print());</script>
