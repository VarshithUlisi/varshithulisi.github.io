---
import Base from '../../layouts/Base.astro';import {posts} from '../../lib/posts';import {render} from 'astro:content';import {path,absolute,dateLabel,name} from '../../lib/site';import projects from '../../data/projects.json';
export async function getStaticPaths(){return (await posts()).map(post=>({params:{id:post.id},props:{post}}));}
const {post}=Astro.props;const {Content}=await render(post);const project=projects.find(p=>p.slug===post.data.related);
const schema={'@type':'BlogPosting',headline:post.data.title,description:post.data.description,datePublished:post.data.published.toISOString(),author:{'@type':'Person','@id':absolute('#person',Astro.site),name},mainEntityOfPage:absolute(`journal/${post.id}/`,Astro.site)};
---
<Base title={post.data.title} description={post.data.description} type="article" schema={schema}><header class="page-head article-head"><p class="eyebrow">Journal / {post.data.category}</p><h1>{post.data.title}</h1><p class="intro">{post.data.description}</p><p class="meta">By {name} · Published <time datetime={post.data.published.toISOString()}>{dateLabel(post.data.published)}</time><br/>Event / period: {post.data.eventDate?<time datetime={post.data.eventDate.toISOString()}>{dateLabel(post.data.eventDate)}</time>:post.data.eventLabel}</p></header><article class="prose article-body">{post.data.image&&<img src={path(post.data.image)} alt={post.data.imageAlt} loading="lazy"/>}<Content/><aside class="note">{post.data.sourceNote || `Source: author-provided brag sheet, pp. ${post.data.sourcePages}. Edited from the supplied account; this entry is not an independent report.`} <a href={path('evidence/')}>Read the evidence notes</a>.</aside>{project&&<p class="links"><a href={path(`projects/${project.slug}/`)}>Explore {project.title} →</a></p>}<p class="links"><a href={path('journal/')}>← Back to the journal</a></p></article></Base>
