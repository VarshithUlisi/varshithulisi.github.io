---
import {path} from '../lib/site';
interface Props {id:string;alt:string;caption?:string;hero?:boolean;}
const {id,alt,caption,hero=false}=Astro.props;
---
<figure class:list={['uplift-photo',{'uplift-photo-hero':hero}]}><img src={path(`images/uplift-2026/${id}-1600.webp`)} srcset={`${path(`images/uplift-2026/${id}-800.webp`)} 800w, ${path(`images/uplift-2026/${id}-1600.webp`)} 1600w`} sizes={hero?'(max-width: 800px) 100vw, 1160px':'(max-width: 700px) 100vw, 560px'} alt={alt} loading={hero?'eager':'lazy'} decoding="async"/>{caption&&<figcaption>{caption}</figcaption>}</figure>
